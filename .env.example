# =============================================================================
# Production environment template for mentimentor.com
# =============================================================================
# Copy to .env (gitignored) and replace every placeholder with real values:
#   cp .env.example .env
#
# NEVER commit real secrets. NEVER put secrets in Dockerfiles or source code.
# =============================================================================

# --- PostgreSQL (Compose service hostname: postgres) -------------------------
POSTGRES_DB=mentor_db
POSTGRES_PASSWORD=change-me-strong-postgres-password
DB_USERNAME=postgres
# Must match POSTGRES_PASSWORD for the Spring Boot datasource
DB_PASSWORD=change-me-strong-postgres-password
# Inside Compose the default is used; override only if needed:
# DB_URL=jdbc:postgresql://postgres:5432/mentor_db

# --- Redis (Compose service hostname: redis) ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Spring Boot -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Heap tuning for the 4 GB VM (optional)
# JAVA_OPTS=-XX:MaxRAMPercentage=60.0 -XX:+UseG1GC

# --- JWT (REQUIRED in production — do not use the application.yml default) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=mentor-marketplace
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- CORS (browser origins allowed to call the API directly) -----------------
# Same-origin via Nginx usually does not need CORS, but keep production domains listed.
CORS_ALLOWED_ORIGINS=https://mentimentor.com,https://www.mentimentor.com,http://mentimentor.com,http://www.mentimentor.com

# --- Google Sign-In ----------------------------------------------------------
# Same Web client ID for backend + frontend build.
# Google Cloud Console → Authorized JavaScript origins must include your public site URL(s).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Frontend production build (baked into the SPA image at build time — not a secret).
# Keep /api so the browser talks to Nginx, which proxies to Spring Boot.
VITE_API_BASE_URL=/api

# --- Twilio SMS OTP (optional; all three required to send SMS) ----------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# Local/staging without Twilio: print OTP in backend logs (disable in real prod)
OTP_LOG_CODE=false

# --- Admin bootstrap (optional) ----------------------------------------------
# ADMIN_BOOTSTRAP_PHONES=+91|9000000000
# ADMIN_PORTAL_SUPER_USERNAME=superadmin
# ADMIN_PORTAL_SUPER_PASSWORD=change-me-min-8-chars

# --- Application tuning (optional) -------------------------------------------
# PLATFORM_FEE_PERCENT=20.0
# AVAILABILITY_SYNC_INTERVAL_MS=60000
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
